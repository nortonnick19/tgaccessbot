[Unit]
Description=TG Access Control API
After=network.target


[Service]
Type=simple

User=root

WorkingDirectory=/opt/tgaccessbot/control-server/app

Environment="PATH=/opt/tgaccessbot/control-server/venv/bin"

ExecStart=/opt/tgaccessbot/control-server/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=5


[Install]
WantedBy=multi-user.target
